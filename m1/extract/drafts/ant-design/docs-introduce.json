    {
      "_intent": "Installation [draft]",
      "_title": {
        "text": "Installation"
      },
      "_lines": [
        {
          "_intent": "Using npm or yarn or pnpm or bun [draft]",
          "_title": {
            "text": "Using npm or yarn or pnpm or bun"
          },
          "_summary": {
            "text": "If you are in a bad network environment, you can try other registries and tools like cnpm."
          },
          "_lines": [
            {
              "_text": {
                "text": "We recommend using npm or yarn or pnpm or bun to install, it not only makes development easier, but also allow you to take advantage of the rich ecosystem of JavaScript packages and tooling."
              }
            }
          ]
        },
        {
          "_intent": "Import in Browser [draft]",
          "_title": {
            "text": "Import in Browser"
          },
          "_summary": {
            "text": "Add script and link tags in your browser and use the global variable antd."
          },
          "_lines": [
            {
              "_text": {
                "text": "We provide antd.js and antd.min.js reset.css under dist folder in antd's npm package. You can also download these files directly from , or unpkg."
              }
            },
            {
              "_text": {
                "text": "We strongly discourage loading the entire files this will add bloat to your application and make it more difficult to receive bugfixes and updates. Antd is intended to be used in conjunction with a build tool, such as webpack, which will make it easy to import only the parts of antd that you are using."
              }
            },
            {
              "_text": {
                "text": "Note: You should import react, react-dom, dayjs before using antd.js."
              }
            }
          ]
        }
      ]
    },

      "_lines": [
        {
          "_text": {
            "text": "表格宽度模式有两种：fixed 和 auto，MDN 详细解释，组件默认为 fixed。如果希望表格列宽自适应，设置 table-layout: auto 即可。"
          }
        },
        {
          "_text": {
            "text": "刷新表格 DOM 元素请使用组件实例方法 refreshTable。"
          }
        },
        {
          "_text": {
            "text": "table-layout: fixed"

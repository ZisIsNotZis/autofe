    "bulk": {
      "_intent": "批量操作：只对选中的行生效",
      "_key": "bulk",
      "_when": "count(selected) > 0",
      "_summary": {
        "text": "Batch operations apply to every selected row."
      },
      "_lines": [
        {
          "_intent": "批量删除所选",
          "_title": {
            "text": "Delete selected"
          },
          "_action": {
            "verb": "operate",
            "when": "role == \"admin\""
          }
        },
        {
          "_intent": "批量邀请所选",
          "_title": {
            "text": "Invite selected"
          },
          "_action": {
            "verb": "operate"
          }
        }
      ]
    }

      "_title": {
        "text": "React Reference Overview"
      },
      "_summary": {
        "text": "This section provides detailed reference documentation for working with React. For an introduction to React, please visit the Learn section."
      },
      "_lines": [
        {
          "_text": {
            "text": "The React reference documentation is broken down into functional subsections:"
          }
        }
      ]
    },
    {
      "_intent": "React Link for React [draft]",
      "_title": {
        "text": "React Link for React"
      },
      "_summary": {
        "text": "Programmatic React features:"
      },
      "_lines": [
        {
          "_intent": "list (4 items) [draft]",
          "_items": [
            {
              "_name": {
                "text": "Hooks - Use different React features from your components."
              },
              "_action": {
                "verb": "navigate",
                "to": "https://react.dev/reference/react/hooks",
                "label": "Hooks"
              }
            },
            {
              "_name": {
                "text": "Components - Built-in components that you can use in your JSX."
              },
              "_action": {
                "verb": "navigate",
                "to": "https://react.dev/reference/react/components",
                "label": "Components"
              }
            },
            {
              "_name": {
                "text": "APIs - APIs that are useful for defining components."
              },
              "_action": {
                "verb": "navigate",
                "to": "https://react.dev/reference/react/apis",
                "label": "APIs"
              }
            },
            {
              "_name": {
                "text": "Directives - Provide instructions to bundlers compatible with React Server Components."
              },
              "_action": {
                "verb": "navigate",
                "to": "https://react.dev/reference/rsc/directives",
                "label": "Directives"
              }
            }
          ]
        }
      ]
    },
    {
      "_intent": "React DOM Link for React DOM [draft]",
      "_title": {
        "text": "React DOM Link for React DOM"
      },
      "_summary": {
        "text": "React DOM contains features that are only supported for web applications (which run in the browser DOM environment). This section is broken into the following:"
      },
      "_lines": [
        {
          "_intent": "list (6 items) [draft]",
          "_items": [
            {
              "_name": {
                "text": "Hooks - Hooks for web applications which run in the browser DOM environment."
              },
              "_action": {
                "verb": "navigate",
                "to": "https://react.dev/reference/react-dom/hooks",
                "label": "Hooks"
              }
            },
            {
              "_name": {
                "text": "Components - React supports all of the browser built-in HTML and SVG components."
              },
              "_action": {
                "verb": "navigate",
                "to": "https://react.dev/reference/react-dom/components",
                "label": "Components"
              }
            },
            {
              "_name": {
                "text": "APIs - The react-dom package contains methods supported only in web applications."
              },
              "_action": {
                "verb": "navigate",
                "to": "https://react.dev/reference/react-dom",
                "label": "APIs"
              }
            },
            {
              "_name": {
                "text": "Client APIs - The react-dom/client APIs let you render React components on the client (in the browser)."
              },
              "_action": {
                "verb": "navigate",
                "to": "https://react.dev/reference/react-dom/client",
                "label": "Client APIs"
              }
            },
            {
              "_name": {
                "text": "Server APIs - The react-dom/server APIs let you render React components to HTML on the server."
              },
              "_action": {
                "verb": "navigate",
                "to": "https://react.dev/reference/react-dom/server",
                "label": "Server APIs"
              }
            },
            {
              "_name": {
                "text": "Static APIs - The react-dom/static APIs let you generate static HTML for React components."
              },
              "_action": {
                "verb": "navigate",
                "to": "https://react.dev/reference/react-dom/static",
                "label": "Static APIs"
              }
            }
          ]
        }
      ]
    },
    {

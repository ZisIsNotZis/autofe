      "_intent": "Rules of React Link for Rules of React [draft]",
      "_title": {
        "text": "Rules of React Link for Rules of React"
      },
      "_summary": {
        "text": "React has idioms — or rules — for how to express patterns in a way that is easy to understand and yields high-quality applications:"
      },
      "_lines": [
        {
          "_intent": "list (3 items) [draft]",
          "_items": [
            {
              "_name": {
                "text": "Components and Hooks must be pure – Purity makes your code easier to understand, debug, and allows React to automatically optimize your components and hooks cor"
              },
              "_action": {
                "verb": "navigate",
                "to": "https://react.dev/reference/rules/components-and-hooks-must-be-pure",
                "label": "Components and Hooks must be pure"
              }
            },
            {
              "_name": {
                "text": "React calls Components and Hooks – React is responsible for rendering components and hooks when necessary to optimize the user experience."
              },
              "_action": {
                "verb": "navigate",
                "to": "https://react.dev/reference/rules/react-calls-components-and-hooks",
                "label": "React calls Components and Hooks"
              }
            },
            {
              "_name": {
                "text": "Rules of Hooks – Hooks are defined using JavaScript functions, but they represent a special type of reusable UI logic with restrictions on where they can be cal"
              },
              "_action": {
                "verb": "navigate",
                "to": "https://react.dev/reference/rules/rules-of-hooks",
                "label": "Rules of Hooks"
              }
            }
          ]
        }
      ]

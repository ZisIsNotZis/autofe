                "to": "https://react.dev/reference/react-compiler/configuration",
                "label": "Configuration"
              }
            },
            {
              "_name": {
                "text": "Directives - Function-level directives to control compilation."
              },
              "_action": {
                "verb": "navigate",
                "to": "https://react.dev/reference/react-compiler/directives",
                "label": "Directives"
              }
            },
            {
              "_name": {
                "text": "Compiling Libraries - Guide for shipping pre-compiled library code."
              },
              "_action": {
                "verb": "navigate",
                "to": "https://react.dev/reference/react-compiler/compiling-libraries",
                "label": "Compiling Libraries"
              }
            }
          ]
        }
      ]
    },

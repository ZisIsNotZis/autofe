  "contribution-rates": {
    "_intent": "说明 Class 1 缴款由雇员与雇主两部分构成，费率取决于类别字母与收入所在档",
    "_title": {
      "text": "Contribution rates"
    },
    "_summary": {
      "text": "An employee’s Class 1 National Insurance is made up of contributions:"
    },
    "_items": [
      {
        "_name": {
          "text": "deducted from their pay (employee’s National Insurance)"
        }
      },
      {
        "_name": {
          "text": "paid by their employer (employer’s National Insurance)"
        }
      }
    ],
    "_text": {
      "text": "The amounts deducted and paid depend on: the category letter, and how much of the employee’s earnings falls within each band."
    },
    "category-letter": {
      "_title": {
        "text": "Category letters"
      },
      "_action": {
        "verb": "navigate",
        "label": "Category letters",
        "to": "https://www.gov.uk/national-insurance-rates-letters/category-letters"
      }
    }
  },

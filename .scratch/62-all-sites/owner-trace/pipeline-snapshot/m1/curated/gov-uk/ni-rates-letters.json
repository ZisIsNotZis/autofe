  "class-1a-1b": {
    "_intent": "费用与福利（expenses and benefits）的 Class 1A/1B 单一费率",
    "_title": {
      "text": "Class 1A and Class 1B rates"
    },
    "_action": {
      "verb": "navigate",
      "to": "https://www.gov.uk/guidance/rates-and-thresholds-for-employers-2022-to-2023"
    },
    "_text": {
      "text": "Employers pay Class 1A and 1B National Insurance on expenses and benefits they give to their employees. The rate from 6 April 2026 to 5 April 2027 on expenses and benefits is 15%. They must also pay Class 1A on some other lump sum payments, for example redundancy payments. HMRC has detailed guidance on all Class 1A and Class 1B rates."
    },

  "class-1a-1b": {
    "_intent": "费用与福利（expenses and benefits）的 Class 1A/1B 单一费率",
    "_title": {
      "text": "Class 1A and Class 1B rates"
    },
    "_text": {
      "text": "Employers pay Class 1A and 1B National Insurance on expenses and benefits they give to their employees. The rate from 6 April 2026 to 5 April 2027 on expenses and benefits is 15%."
    }
  },
  "example": {
    "_intent": "用一个年度示例说明分段累进如何得出周缴款额",
    "_title": {
      "text": "Example"
    },
    "_summary": {
      "text": "If you’re in category A and you earn £1,000 in a week you’ll pay:"
    },
    "_items": [
      {
        "_name": {
          "text": "nothing on the first £242"
        }
      },
      {
        "_name": {
          "text": "8% (£58) on your earnings between £242.01 and £967"
        }
      },
      {
        "_name": {
          "text": "2% (£0.66) on the remaining earnings above £967"
        }
      }
    ],
    "_text": {
      "text": "This means your National Insurance payment will be £58.66 for the week."
    }
  },

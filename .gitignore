.pi/
node_modules/
.tmp/
.DS_Store

# Corpus page captures are regenerable (pipeline) and contain third-party
# trademarks; keep only the durable acceptance evidence and summary.
/corpus/*
!/corpus/_evidence
!/corpus/failures.json
# run-report.json is a transient per-run artifact; the durable summary is
# corpus/_evidence/corpus-summary.json.

# Common local caches and temporary workspaces
__pycache__/
worktrees/
.worktrees/

# Local secrets, test caches, and generated logs
.pytest_cache/
.ruff_cache/
.mypy_cache/
.cache/
.env
.env.*
!.env.example
*.log
